# ============================================================
# BISWARA ERP - Variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# CE FICHIER NE CONTIENT JAMAIS DE SECRETS RÉELS (clés Supabase,
# tokens GitHub/Vercel, mots de passe). Ils vont uniquement dans
# `.env.local` qui est EXCLU du contrôle de version (.gitignore).
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REMPLACER_PAR_LA_CLE_PUBLISHABLE
# Clé service_role : UNIQUEMENT côté serveur, JAMAIS exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_PAR_LA_CLE_SERVICE_ROLE

# --- Base de données (pooler Supabase pour Drizzle ORM) ---
# ⚠️ NE PAS utiliser la connexion directe db.<ref>.supabase.co (IPv6-only) :
#    elle provoque `getaddrinfo ENOTFOUND`. Utiliser le pooler Supavisor (IPv4).
# Format : postgresql://postgres.<PROJECT_REF>:<PASS>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# (le ssl est configuré en code dans src/db/index.ts — ne pas ajouter ?sslmode=require dans l'URL)
DATABASE_URL=postgresql://postgres.VOTRE_PROJET:REMPLACER@aws-0-VOTRE_REGION.pooler.supabase.com:5432/postgres

# --- Supabase Auth (automatique via SDK) ---
# URL de redirection après authentification
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Super Admin initial (créé lors du seed initial) ---
# NOTE : ne jamais committer de mot de passe réel en clair.
SUPER_ADMIN_USERNAME=rachade
SUPER_ADMIN_EMAIL=REMPLACER_PAR_EMAIL_ADMIN
SUPER_ADMIN_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_ADMIN

# --- WhatsApp (souscription / notifications) ---
NEXT_PUBLIC_BISWARA_WHATSAPP_NUMBER=+2694306306
# Provider WhatsApp (ex: Meta Cloud API / Twilio) - message templates
WHATSAPP_PROVIDER_TOKEN=REMPLACER
WHATSAPP_PHONE_NUMBER_ID=REMPLACER

# --- Emails (Notification Engine) ---
SMTP_HOST=REMPLACER
SMTP_PORT=587
SMTP_USER=REMPLACER
SMTP_PASSWORD=REMPLACER
SMTP_FROM=no-reply@biswara.app

# --- Déploiement / environnements ---
NODE_ENV=development

# --- Numérotation / paramètres par défaut (override possibles) ---
DEFAULT_CURRENCY=KMF
DEFAULT_COUNTRY=KM
